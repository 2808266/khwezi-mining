   "source": [
    "\n",
    "\n",
    "\n",
    "# PART B: WORKER HEALTH AND SAFETY MONITORING\n",
    "\n",
    "def worker_risk(\n",
    "    ppe,\n",
    "    fatigue,\n",
    "    near_misses,\n",
    "    training,\n",
    "    previous_incidents\n",
    "):\n",
    "\n",
    "    score = 0\n",
    "\n",
    "    if ppe == \"No\":\n",
    "        score = score + 2\n",
    "\n",
    "    if fatigue == \"High\":\n",
    "        score = score + 2\n",
    "\n",
    "    elif fatigue == \"Medium\":\n",
    "        score = score + 1\n",
    "\n",
    "    if near_misses >= 2:\n",
    "        score = score + 2\n",
    "\n",
    "    if training == \"Incomplete\":\n",
    "        score = score + 2\n",
    "\n",
    "    if previous_incidents >= 2:\n",
    "        score = score + 1\n",
    "\n",
    "    if score >= 6:\n",
    "        return \"Critical\"\n",
    "\n",
    "    elif score >= 4:\n",
    "        return \"High\"\n",
    "\n",
    "    elif score >= 2:\n",
    "        return \"Medium\"\n",
    "\n",
    "    else:\n",
    "        return \"Low\"\n",
    "\n",
    "\n",
    "def safety_warning(\n",
    "    ppe,\n",
    "    training,\n",
    "    fatigue,\n",
    "    near_misses,\n",
    "    previous_incidents\n",
    "):\n",
    "\n",
    "    warning = \"\"\n",
    "\n",
    "    if ppe == \"No\":\n",
    "        warning = warning + \"PPE non-compliance, \"\n",
    "\n",
    "    if training == \"Incomplete\":\n",
    "        warning = warning + \"Training incomplete, \"\n",
    "\n",
    "    if fatigue == \"High\":\n",
    "        warning = warning + \"High fatigue, \"\n",
    "\n",
    "    if near_misses >= 2:\n",
    "        warning = warning + \"Multiple near misses, \"\n",
    "\n",
    "    if previous_incidents >= 2:\n",
    "        warning = warning + \"Multiple previous incidents, \"\n",
    "\n",
    "    if warning == \"\":\n",
    "        return \"No warning\"\n",
    "\n",
    "    return warning[:-2]\n",
    "\n",
    "\n",
    "risk_levels = [\"\"] * len(workers)\n",
    "\n",
    "safety_warnings = [\"\"] * len(workers)\n",
    "\n",
    "\n",
    "for i in range(len(workers)):\n",
    "\n",
    "    risk_levels[i] = worker_risk(\n",
    "        workers[\"PPE_Compliance\"][i],\n",
    "        workers[\"Fatigue_Level\"][i],\n",
    "        workers[\"Near_Misses\"][i],\n",
    "        workers[\"Training_Status\"][i],\n",
    "        workers[\"Previous_Incidents\"][i]\n",
    "    )\n",
    "\n",
    "    safety_warnings[i] = safety_warning(\n",
    "        workers[\"PPE_Compliance\"][i],\n",
    "        workers[\"Training_Status\"][i],\n",
    "        workers[\"Fatigue_Level\"][i],\n",
    "        workers[\"Near_Misses\"][i],\n",
    "        workers[\"Previous_Incidents\"][i]\n",
    "    )\n",
    "\n",
    "\n",
    "workers[\"Risk_Level\"] = risk_levels\n",
    "\n",
    "workers[\"Safety_Warning\"] = safety_warnings\n",
    "\n",
    "\n",
    "def show_worker_safety():\n",
    "\n",
    "    st.title(\n",
    "        \"👷 Worker Health and Safety\"\n",
    "    )\n",
    "\n",
    "    risk_filter = st.selectbox(\n",
    "        \"Filter by risk level\",\n",
    "        [\n",
    "            \"All\",\n",
    "            \"Low\",\n",
    "            \"Medium\",\n",
    "            \"High\",\n",
    "            \"Critical\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    if risk_filter == \"All\":\n",
    "\n",
    "        st.dataframe(\n",
    "            workers\n",
    "        )\n",
    "\n",
    "    else:\n",
    "\n",
    "        filtered_workers = workers[\n",
    "            workers[\"Risk_Level\"] == risk_filter\n",
    "        ]\n",
    "\n",
    "        st.dataframe(\n",
    "            filtered_workers\n",
    "        )\n",
    "\n",
    "    st.subheader(\n",
    "        \"Workers Requiring Attention\"\n",
    "    )\n",
    "\n",
    "    attention = workers[\n",
    "        workers[\"Safety_Warning\"] != \"No warning\"\n",
    "    ]\n",
    "\n",
    "    st.dataframe(\n",
    "        attention\n",
    "    )\n",
    "\n",
    "\n",
    "# PART C: SAFETY INCIDENT DATABASE\n",
    "\n",
    "def show_safety_incidents():\n",
    "\n",
    "    global incidents\n",
    "\n",
    "    st.title(\n",
    "        \"⚠️ Safety Incident Database\"\n",
    "    )\n",
    "\n",
    "    st.metric(\n",
    "        \"Total Incidents\",\n",
    "        len(incidents)\n",
    "    )\n",
    "\n",
    "    search_id = st.text_input(\n",
    "        \"Search Incident ID\"\n",
    "    )\n",
    "\n",
    "    if search_id != \"\":\n",
    "\n",
    "        search_result = incidents[\n",
    "            incidents[\"Incident_ID\"] == search_id\n",
    "        ]\n",
    "\n",
    "        st.dataframe(\n",
    "            search_result\n",
    "        )\n",
    "\n",
    "    severity = st.selectbox(\n",
    "        \"Filter by severity\",\n",
    "        [\n",
    "            \"All\",\n",
    "            \"Low\",\n",
    "            \"Medium\",\n",
    "            \"High\",\n",
    "            \"Critical\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    if severity == \"All\":\n",
    "\n",
    "        st.dataframe(\n",
    "            incidents\n",
    "        )\n",
    "\n",
    "    else:\n",
    "\n",
    "        filtered_incidents = incidents[\n",
    "            incidents[\"Severity\"] == severity\n",
    "        ]\n",
    "\n",
    "        st.dataframe(\n",
    "            filtered_incidents\n",
    "        )\n",
    "\n",
    "    st.subheader(\n",
    "        \"Add New Incident\"\n",
    "    )\n",
    "\n",
    "    with st.form(\n",
    "        \"incident_form\"\n",
    "    ):\n",
    "\n",
    "        incident_id = st.text_input(\n",
    "            \"Incident ID\"\n",
    "        )\n",
    "\n",
    "        date = st.date_input(\n",
    "            \"Date\"\n",
    "        )\n",
    "\n",
    "        time = st.text_input(\n",
    "            \"Time\"\n",
    "        )\n",
    "\n",
    "        shift = st.selectbox(\n",
    "            \"Shift\",\n",
    "            [\n",
    "                \"Day\",\n",
    "                \"Night\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        location = st.text_input(\n",
    "            \"Location\"\n",
    "        )\n",
    "\n",
    "        department = st.text_input(\n",
    "            \"Department\"\n",
    "        )\n",
    "\n",
    "        incident_type = st.text_input(\n",
    "            \"Incident Type\"\n",
    "        )\n",
    "\n",
    "        incident_severity = st.selectbox(\n",
    "            \"Severity\",\n",
    "            [\n",
    "                \"Low\",\n",
    "                \"Medium\",\n",
    "                \"High\",\n",
    "                \"Critical\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        injury_status = st.text_input(\n",
    "            \"Injury Status\"\n",
    "        )\n",
    "\n",
    "        lost_time = st.selectbox(\n",
    "            \"Lost Time Injury\",\n",
    "            [\n",
    "                \"No\",\n",
    "                \"Yes\"\n",
    "            ]\n",
    "        )\n",
    "\n",
    "        cause = st.text_input(\n",
    "            \"Cause\"\n",
    "        )\n",
    "\n",
    "        corrective_action = st.text_input(\n",
    "            \"Corrective Action\"\n",
    "        )\n",
    "\n",
    "        incident_status = st.text_input(\n",
    "            \"Incident Status\"\n",
    "        )\n",
    "\n",
    "        save_incident = st.form_submit_button(\n",
    "            \"Save Incident\"\n",
    "        )\n",
    "\n",
    "    if save_incident:\n",
    "\n",
    "        if incident_id == \"\":\n",
    "\n",
    "            st.error(\n",
    "                \"Please enter an Incident ID\"\n",
    "            )\n",
    "\n",
    "        elif incident_id in incidents[\n",
    "            \"Incident_ID\"\n",
    "        ].values:\n",
    "\n",
    "            st.error(\n",
    "                \"Incident ID already exists\"\n",
    "            )\n",
    "\n",
    "        elif location == \"\":\n",
    "\n",
    "            st.error(\n",
    "                \"Please enter the incident location\"\n",
    "            )\n",
    "\n",
    "        elif department == \"\":\n",
    "\n",
    "            st.error(\n",
    "                \"Please enter the department\"\n",
    "            )\n",
    "\n",
    "        elif incident_type == \"\":\n",
    "\n",
    "            st.error(\n",
    "                \"Please enter the incident type\"\n",
    "            )\n",
    "\n",
    "        elif cause == \"\":\n",
    "\n",
    "            st.error(\n",
    "                \"Please enter the cause\"\n",
    "            )\n",
    "\n",
    "        else:\n",
    "\n",
    "            new_incident = pd.DataFrame({\n",
    "\n",
    "                \"Incident_ID\": [incident_id],\n",
    "                \"Date\": [str(date)],\n",
    "                \"Time\": [time],\n",
    "                \"Shift\": [shift],\n",
    "                \"Location\": [location],\n",
    "                \"Department\": [department],\n",
    "                \"Incident_Type\": [incident_type],\n",
    "                \"Severity\": [incident_severity],\n",
    "                \"Injury_Status\": [injury_status],\n",
    "                \"Lost_Time_Injury\": [lost_time],\n",
    "                \"Cause\": [cause],\n",
    "                \"Corrective_Action\": [corrective_action],\n",
    "                \"Incident_Status\": [incident_status]\n",
    "            })\n",
    "\n",
    "            incidents = pd.concat(\n",
    "                [\n",
    "                    incidents,\n",
    "                    new_incident\n",
    "                ],\n",
    "                ignore_index=True\n",
    "            )\n",
    "\n",
    "            incidents.to_csv(\n",
    "                \"incidents.csv\",\n",
    "                index=False\n",
    "            )\n",
    "\n",
    "            st.success(\n",
    "                \"Incident saved successfully\"\n",
    "            )\n",
    "\n",
    "            st.rerun()\n",
    "\n",
    "    st.subheader(\n",
    "        \"Incident Analysis\"\n",
    "    )\n",
    "\n",
    "    st.write(\n",
    "        \"Incidents by Severity\"\n",
    "    )\n",
    "\n",
    "    severity_counts = incidents[\n",
    "        \"Severity\"\n",
    "    ].value_counts()\n",
    "\n",
    "    st.bar_chart(\n",
    "        severity_counts\n",
    "    )\n",
    "\n",
    "    st.write(\n",
    "        \"Incidents by Department\"\n",
    "    )\n",
    "\n",
    "    department_counts = incidents[\n",
    "        \"Department\"\n",
    "    ].value_counts()\n",
    "\n",
    "    st.bar_chart(\n",
    "        department_counts\n",
    "    )\n",
    "\n",
    "    st.write(\n",
    "        \"Incidents by Shift\"\n",
    "    )\n",
    "\n",
    "    shift_counts = incidents[\n",
    "        \"Shift\"\n",
    "    ].value_counts()\n",
    "\n",
    "    st.bar_chart(\n",
    "        shift_counts\n",
    "    )\n",
    "\n",
    "    st.write(\n",
    "        \"Incident Types\"\n",
    "    )\n",
    "\n",
    "    type_counts = incidents[\n",
    "        \"Incident_Type\"\n",
    "    ].value_counts()\n",
    "\n",
    "    st.bar_chart(\n",
    "        type_counts\n",
    "    )\n",
    "\n",
    "    st.write(\n",
    "        \"Incident Trend\"\n",
    "    )\n",
    "\n",
    "    incident_trend = incidents[\n",
    "        \"Date\"\n",
    "    ].value_counts().sort_index()\n",
    "\n",
    "    st.line_chart(\n",
    "        incident_trend\n",
    "    )\n",
    "\n",
    "\n"
   ]
